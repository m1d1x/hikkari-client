<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app sandbox is intentionally OFF: the engine dylib opens raw
	     network connections, reads/writes its own state directory and (once
	     the macOS VPN backend lands) spawns the sing-box child process — none
	     of which a sandboxed app may do. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- libnekkobox.dylib is built locally and signed ad-hoc, so the hardened
	     runtime must be told not to require a matching team signature. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
