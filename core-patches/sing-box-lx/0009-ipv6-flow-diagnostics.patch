@@ -0,0 +1,48 @@
+package route
+
+import (
+	"context"
+	"path/filepath"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/common/logger"
+)
+
+// ipv6FlowDiag is Hikkari's temporary instrument for Russian sites with an AAAA
+// record that close in Chrome on Windows (tester-002, 05.11): a flow dialled
+// direct by its IPv6 address although a rule should have replaced it with the
+// sniffed name. For each TCP flow that arrives at an IPv6 address it logs who
+// sent it, what the sniff found and where it was routed. The address itself stays
+// out. It only logs. Remove it with the fix.
+type ipv6FlowDiag struct {
+	active bool
+	start  time.Time
+}
+
+func newIPv6FlowDiag(metadata adapter.InboundContext) ipv6FlowDiag {
+	return ipv6FlowDiag{active: metadata.Destination.IsIPv6(), start: time.Now()}
+}
+
+func (d ipv6FlowDiag) report(ctx context.Context, log logger.ContextLogger, metadata *adapter.InboundContext, rule adapter.Rule, ruleIndex int, matchErr error) {
+	if !d.active {
+		return
+	}
+	process := "?"
+	if metadata.ProcessInfo != nil && metadata.ProcessInfo.ProcessPath != "" {
+		process = filepath.Base(metadata.ProcessInfo.ProcessPath)
+	}
+	dest := "ipv6"
+	if metadata.Destination.IsFqdn() {
+		dest = "name"
+	}
+	action := "final"
+	if rule != nil {
+		action = rule.Action().String()
+	} else {
+		ruleIndex = -1
+	}
+	log.WarnContext(ctx, "[ipv6-diag] proc=", process, " port=", metadata.Destination.Port, " dest=", dest,
+		" proto=", metadata.Protocol, " domain=", metadata.Domain, " sniff_err=", metadata.SniffError,
+		" rule=", ruleIndex, " action=", action, " took=", time.Since(d.start).Round(time.Millisecond), " err=", matchErr)
+}
