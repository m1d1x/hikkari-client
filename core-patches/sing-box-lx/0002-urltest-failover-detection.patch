@@ -0,0 +1,158 @@
+package group
+
+import (
+	"io"
+	"net"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	N "github.com/sagernet/sing/common/network"
+)
+
+func newSuspectGroup(t *testing.T) (g *URLTestGroup, held, spare *penaltyDialNode) {
+	t.Helper()
+	held = &penaltyDialNode{tag: "held", addr: "server"}
+	spare = &penaltyDialNode{tag: "spare", addr: "server"}
+	g = newPenaltyTestGroup(t, []*penaltyDialNode{held, spare}, map[string]uint16{"held": 10, "spare": 50})
+	g.failover = true
+	g.selectedOutboundTCP = held
+	g.selectedOutboundUDP = held
+	return g, held, spare
+}
+
+func waitSuspect(t *testing.T, what string, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(3 * time.Second)
+	for !cond() {
+		if time.Now().After(deadline) {
+			t.Fatal("timed out waiting for ", what)
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}
+
+func TestSuspectThatDoesNotAnswerLosesTheSelection(t *testing.T) {
+	g, held, spare := newSuspectGroup(t)
+	held.err = syscall.ECONNRESET
+	g.suspect(held)
+	waitSuspect(t, "the move", func() bool { return g.heldTCP() == adapter.Outbound(spare) })
+	waitSuspect(t, "the check after the move", func() bool { return !g.suspectRunning.Load() })
+	if g.selectedOutboundUDP != adapter.Outbound(spare) {
+		t.Fatal("UDP held on the same node must move too")
+	}
+	if g.history.LoadURLTestHistory("held") != nil {
+		t.Fatal("the dead node keeps no history")
+	}
+}
+
+// A dead site looks exactly like a dead node from one connection. The probe decides.
+func TestSuspectThatAnswersStays(t *testing.T) {
+	g, held, _ := newSuspectGroup(t)
+	g.suspect(held)
+	waitSuspect(t, "the probe", func() bool { return g.suspectEnd.Load() != 0 })
+	waitSuspect(t, "the probe to finish", func() bool { return !g.suspectRunning.Load() })
+	if g.heldTCP() != adapter.Outbound(held) {
+		t.Fatal("a node that answers must keep the selection")
+	}
+	dials := held.dials
+	g.suspect(held)
+	time.Sleep(50 * time.Millisecond)
+	if held.dials != dials {
+		t.Fatal("a second suspicion inside suspectGap must not probe")
+	}
+}
+
+func TestSuspectIgnoresNodeNoLongerHeld(t *testing.T) {
+	g, held, spare := newSuspectGroup(t)
+	g.selectedOutboundTCP = spare
+	g.suspect(held)
+	time.Sleep(50 * time.Millisecond)
+	if held.dials != 0 {
+		t.Fatal("old connections must not trigger probes of a node already left")
+	}
+}
+
+type suspectRecorder struct {
+	net.Conn
+	readErr error
+	reads   chan []byte
+}
+
+func (c *suspectRecorder) Read(p []byte) (int, error) {
+	data, ok := <-c.reads
+	if !ok {
+		return 0, c.readErr
+	}
+	return copy(p, data), nil
+}
+func (c *suspectRecorder) Write(p []byte) (int, error) { return len(p), nil }
+func (c *suspectRecorder) Close() error                { return nil }
+
+func watched(g *URLTestGroup, node adapter.Outbound, readErr error) (*firstResponseConn, *suspectRecorder) {
+	inner := &suspectRecorder{readErr: readErr, reads: make(chan []byte, 1)}
+	return g.watchFirstResponse(N.NetworkTCP, node, inner).(*firstResponseConn), inner
+}
+
+func TestFailureBeforeFirstByteIsSuspicious(t *testing.T) {
+	g, held, spare := newSuspectGroup(t)
+	held.err = syscall.ECONNRESET
+	conn, inner := watched(g, held, io.EOF)
+	close(inner.reads)
+	_, _ = conn.Read(make([]byte, 8))
+	waitSuspect(t, "the move", func() bool { return g.heldTCP() == adapter.Outbound(spare) })
+}
+
+func TestFailureAfterFirstByteIsNot(t *testing.T) {
+	g, held, _ := newSuspectGroup(t)
+	held.err = syscall.ECONNRESET
+	conn, inner := watched(g, held, io.EOF)
+	inner.reads <- []byte("x")
+	_, _ = conn.Read(make([]byte, 8))
+	close(inner.reads)
+	_, _ = conn.Read(make([]byte, 8))
+	time.Sleep(50 * time.Millisecond)
+	if held.dials != 0 {
+		t.Fatal("a connection that was answered ended normally for the node")
+	}
+}
+
+func TestSilenceAfterWriteIsSuspiciousButNotBeforeIt(t *testing.T) {
+	old := suspectResponseBudget
+	suspectResponseBudget = 20 * time.Millisecond
+	defer func() { suspectResponseBudget = old }()
+	g, held, spare := newSuspectGroup(t)
+	held.err = syscall.ECONNRESET
+	conn, _ := watched(g, held, io.EOF)
+	time.Sleep(60 * time.Millisecond)
+	if held.dials != 0 {
+		t.Fatal("nothing was sent, silence means nothing yet")
+	}
+	_, _ = conn.Write([]byte("request"))
+	waitSuspect(t, "the move", func() bool { return g.heldTCP() == adapter.Outbound(spare) })
+}
+
+func TestClosingBeforeAnswerIsNotSuspicious(t *testing.T) {
+	old := suspectResponseBudget
+	suspectResponseBudget = 20 * time.Millisecond
+	defer func() { suspectResponseBudget = old }()
+	g, held, _ := newSuspectGroup(t)
+	held.err = syscall.ECONNRESET
+	conn, _ := watched(g, held, io.EOF)
+	_, _ = conn.Write([]byte("request"))
+	_ = conn.Close()
+	time.Sleep(60 * time.Millisecond)
+	if held.dials != 0 {
+		t.Fatal("the client walked away, the node did nothing wrong")
+	}
+}
+
+func TestLeastTestIsNotWatched(t *testing.T) {
+	g, held, _ := newSuspectGroup(t)
+	g.failover = false
+	inner := &suspectRecorder{}
+	if g.watchFirstResponse(N.NetworkTCP, held, inner) != net.Conn(inner) {
+		t.Fatal("only failover groups are watched")
+	}
+}
diff --git a/protocol/group/urltest_voice_hikkari.go b/protocol/group/urltest_voice_hikkari.go
new file mode 100644
index 0000000..6d33a68
--- /dev/null
+++ b/protocol/group/urltest_voice_hikkari.go
@@ -0,0 +1,428 @@
+package group
+
+// hikkari: voice watchdog for mode: failover.
+//
+// UDP gives the group nothing to react to. A datagram has no dial error and no
+// first byte to wait for, and the suspicion probe watches TCP only. With only a
+// call up, a dead node is noticed by the next planned tick, two minutes later,
+// and every new call socket lands on the dead node until then.
+//
+// So while a UDP flow is active, the group pings a STUN server through the node
+// held for UDP every voicePingInterval. voiceMisses pings in a row without an
+// answer within voicePingTimeout make the node a suspect. A fresh socket through
+// it and sockets through the best candidates are then pinged side by side. Only
+// a candidate that answers while the held node stays silent takes the UDP
+// selection; if nobody answers, the user's own network is down and the group
+// stays. After a move the old node gets the TCP suspicion probe, and TCP moves by
+// its own rules. Flows already open stay on the node they started on, as on any
+// move. Without an active flow nothing is sent.
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/binary"
+	"net"
+	"slices"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/common/buf"
+	"github.com/sagernet/sing/common/bufio"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+var (
+	// voiceTarget answers STUN binding requests. A public STUN server works for any
+	// node, ours or not.
+	voiceTarget = M.ParseSocksaddr("stun.l.google.com:19302")
+	// voicePingInterval is the ping rate while a flow is active: 4 packets a second.
+	voicePingInterval = 250 * time.Millisecond
+	// voicePingTimeout: an answer later than this is a miss. For a call a reply after
+	// a second and a half is as bad as none.
+	voicePingTimeout = 500 * time.Millisecond
+	// voiceMisses in a row, under a second, make the held node a suspect. The fresh
+	// socket of the verification is the fourth strike.
+	voiceMisses = 3
+	// voiceVerifyWindow is how long the suspect and the candidates get to answer.
+	voiceVerifyWindow = 750 * time.Millisecond
+	// voiceCandidates is how many other nodes are tried, fastest first.
+	voiceCandidates = 2
+	// voiceActiveWindow: a flow with no packet out for this long is over.
+	voiceActiveWindow = 2 * time.Second
+	// voiceFlowPackets out make a flow active. A DNS or NTP exchange never gets there.
+	voiceFlowPackets = int64(10)
+	// voiceMoveGap is the quiet time after a move, against hopping between nodes.
+	voiceMoveGap = 30 * time.Second
+)
+
+// watchVoice wraps a UDP flow of a failover group to report its activity.
+func (g *URLTestGroup) watchVoice(conn net.PacketConn) net.PacketConn {
+	if !g.failover {
+		return conn
+	}
+	return &voiceFlowConn{NetPacketConn: bufio.NewPacketConn(conn), group: g}
+}
+
+// voiceFlow marks a packet out of an active flow and starts the watchdog if it is
+// not running.
+func (g *URLTestGroup) voiceFlow() {
+	g.voiceLast.Store(time.Now().UnixNano())
+	if g.ctx.Err() != nil || !g.voiceRunning.CompareAndSwap(false, true) {
+		return
+	}
+	go func() {
+		defer g.voiceRunning.Store(false)
+		g.voiceWatch()
+	}()
+}
+
+func (g *URLTestGroup) voiceActive() bool {
+	return time.Since(time.Unix(0, g.voiceLast.Load())) < voiceActiveWindow
+}
+
+// heldUDP reads the UDP selection under the lock moveSelection writes it with.
+func (g *URLTestGroup) heldUDP() adapter.Outbound {
+	g.access.Lock()
+	held := g.selectedOutboundUDP
+	g.access.Unlock()
+	if held == nil {
+		held, _ = g.Select(N.NetworkUDP)
+	}
+	return held
+}
+
+// voiceWatch pings through the held node while a flow is active.
+func (g *URLTestGroup) voiceWatch() {
+	var pinger *voicePinger
+	defer func() {
+		if pinger != nil {
+			pinger.close()
+		}
+	}()
+	ticker := time.NewTicker(voicePingInterval)
+	defer ticker.Stop()
+	misses := 0
+	for g.voiceActive() {
+		held := g.heldUDP()
+		if held == nil {
+			return
+		}
+		if pinger != nil && pinger.node != held {
+			pinger.close()
+			pinger, misses = nil, 0
+		}
+		if pinger == nil {
+			pinger = g.openVoicePinger(held)
+		}
+		if pinger != nil {
+			answered, missed := pinger.collect()
+			if answered {
+				misses = 0
+			}
+			misses += missed
+			pinger.send()
+		}
+		// A socket that broke is a stronger sign than a lost ping: verify now.
+		if pinger == nil || pinger.broken() || misses >= voiceMisses {
+			fresh := g.voiceVerify(held, misses)
+			if pinger != nil {
+				pinger.close()
+			}
+			pinger, misses = fresh, 0
+		}
+		select {
+		case <-g.ctx.Done():
+			return
+		case <-ticker.C:
+		}
+	}
+}
+
+// voiceVerify pings the suspect through a fresh socket and the candidates side by
+// side, and moves the UDP selection to a candidate that answers if the suspect
+// does not. All the sockets are fresh, so a live suspect answers about as fast as
+// a candidate: once one answered, the suspect gets voicePingInterval more, at
+// least voicePingTimeout in all and never more than voiceVerifyWindow. It returns
+// the suspect's fresh pinger when the suspect answered, for the watchdog to keep.
+func (g *URLTestGroup) voiceVerify(held adapter.Outbound, misses int) *voicePinger {
+	start := time.Now()
+	tag := RealTag(g.outbound, held)
+	moveAllowed := time.Since(time.Unix(0, g.voiceMoved.Load())) >= voiceMoveGap
+	nodes := []adapter.Outbound{held}
+	if moveAllowed {
+		nodes = append(nodes, g.voiceCandidateList(held)...)
+	}
+	type verdict struct {
+		index  int
+		ok     bool
+		pinger *voicePinger // the suspect's, when it answered
+	}
+	verdicts := make(chan verdict, len(nodes))
+	stop := make(chan struct{})
+	for i, node := range nodes {
+		go func() {
+			pinger := g.openVoicePinger(node)
+			ok := pinger != nil && pinger.answers(voiceVerifyWindow, stop)
+			if pinger != nil && (i != 0 || !ok) {
+				pinger.close()
+				pinger = nil
+			}
+			verdicts <- verdict{i, ok, pinger}
+		}()
+	}
+	// Once decided, the rest stop pinging, and their sockets are closed before
+	// this returns: a late suspect hands over one nobody takes.
+	pending := len(nodes)
+	defer func() {
+		close(stop)
+		for ; pending > 0; pending-- {
+			if v := <-verdicts; v.pinger != nil {
+				v.pinger.close()
+			}
+		}
+	}()
+	// The suspect is out once it failed or its time ran out; then the first
+	// candidate in rank order that answered takes over, or, once every candidate
+	// gave its verdict, nobody does.
+	deadline := time.NewTimer(voiceVerifyWindow)
+	defer deadline.Stop()
+	answered := make([]bool, len(nodes))
+	heldOut, candidatesLeft := false, len(nodes)-1
+	for !heldOut || (candidatesLeft > 0 && !slices.Contains(answered, true)) {
+		select {
+		case v := <-verdicts:
+			pending--
+			switch {
+			case v.index == 0 && v.ok:
+				g.logger.Debug("voice: ", tag, " answered on a fresh socket after ", misses, " misses")
+				g.voiceSilent.Store(false)
+				return v.pinger
+			case v.index == 0:
+				heldOut = true
+			default:
+				candidatesLeft--
+				if v.ok && !slices.Contains(answered, true) && !heldOut {
+					wait := max(voicePingTimeout, time.Since(start)+voicePingInterval)
+					deadline.Reset(min(voiceVerifyWindow, wait) - time.Since(start))
+				}
+				answered[v.index] = v.ok
+			}
+		case <-deadline.C:
+			heldOut = true
+		}
+	}
+	for i := 1; i < len(nodes); i++ {
+		if !answered[i] {
+			continue
+		}
+		g.voiceMoved.Store(time.Now().UnixNano())
+		g.voiceSilent.Store(false)
+		g.moveSelection(N.NetworkUDP, nodes[i], nil)
+		g.logger.Warn("[voice] ", tag, " silent after ", misses, " misses, UDP moved to ", RealTag(g.outbound, nodes[i]),
+			" in ", time.Since(start).Milliseconds(), "ms")
+		// TCP decides by its own probe whether the node is dead for it too.
+		g.suspect(held)
+		return nil
+	}
+	if !g.voiceSilent.Swap(true) {
+		if moveAllowed {
+			g.logger.Warn("[voice] ", tag, " silent after ", misses, " misses, no other node answered, staying")
+		} else {
+			g.logger.Warn("[voice] ", tag, " silent after ", misses, " misses, staying: moved less than ", voiceMoveGap, " ago")
+		}
+	}
+	return nil
+}
+
+// voiceCandidateList is the fastest other UDP nodes with history.
+func (g *URLTestGroup) voiceCandidateList(held adapter.Outbound) []adapter.Outbound {
+	type ranked struct {
+		node  adapter.Outbound
+		delay uint16
+	}
+	var list []ranked
+	for _, detour := range g.outbounds {
+		if detour == held || !supportsNetwork(detour, N.NetworkUDP) {
+			continue
+		}
+		if history := g.history.LoadURLTestHistory(RealTag(g.outbound, detour)); history != nil {
+			list = append(list, ranked{detour, history.Delay})
+		}
+	}
+	for i := 1; i < len(list); i++ {
+		for j := i; j > 0 && list[j].delay < list[j-1].delay; j-- {
+			list[j], list[j-1] = list[j-1], list[j]
+		}
+	}
+	candidates := make([]adapter.Outbound, 0, voiceCandidates)
+	for _, r := range list {
+		if len(candidates) == voiceCandidates {
+			break
+		}
+		candidates = append(candidates, r.node)
+	}
+	return candidates
+}
+
+// voicePinger is one UDP socket through a node to voiceTarget.
+type voicePinger struct {
+	node    adapter.Outbound
+	conn    net.PacketConn
+	replies chan [12]byte
+	dead    atomic.Bool
+	// sent counts the pings; pending holds the ones not answered yet, by number.
+	// The watchdog sends one per tick, so a ping's age is counted in ticks: a
+	// wall-clock age would land a hair under the timeout one tick in two and
+	// count the miss a whole interval late.
+	sent    int
+	pending map[[12]byte]int
+}
+
+func (g *URLTestGroup) openVoicePinger(node adapter.Outbound) *voicePinger {
+	ctx, cancel := context.WithTimeout(g.ctx, voiceVerifyWindow)
+	defer cancel()
+	conn, err := node.ListenPacket(ctx, voiceTarget)
+	if err != nil {
+		return nil
+	}
+	p := &voicePinger{node: node, conn: conn, replies: make(chan [12]byte, 16), pending: make(map[[12]byte]int)}
+	go p.read()
+	return p
+}
+
+func (p *voicePinger) read() {
+	buffer := make([]byte, 1500)
+	for {
+		n, _, err := p.conn.ReadFrom(buffer)
+		if err != nil {
+			p.dead.Store(true)
+			close(p.replies)
+			return
+		}
+		if id, ok := stunBindingSuccess(buffer[:n]); ok {
+			select {
+			case p.replies <- id:
+			default:
+			}
+		}
+	}
+}
+
+func (p *voicePinger) close() { _ = p.conn.Close() }
+
+func (p *voicePinger) broken() bool { return p.dead.Load() }
+
+func (p *voicePinger) send() {
+	var id [12]byte
+	_, _ = rand.Read(id[:])
+	request := make([]byte, 20)
+	binary.BigEndian.PutUint16(request[0:], 0x0001) // Binding Request, no attributes
+	binary.BigEndian.PutUint32(request[4:], stunMagicCookie)
+	copy(request[8:], id[:])
+	if _, err := p.conn.WriteTo(request, voiceTarget); err != nil {
+		p.dead.Store(true)
+		return
+	}
+	p.sent++
+	p.pending[id] = p.sent
+}
+
+// collect, called once a tick before the next send, takes the answers that
+// arrived and returns whether one came in time and how many pings ran out of
+// time without one.
+func (p *voicePinger) collect() (answered bool, missed int) {
+	age := func(number int) time.Duration { return time.Duration(p.sent-number+1) * voicePingInterval }
+	for drained := false; !drained; {
+		select {
+		case id, ok := <-p.replies:
+			if !ok {
+				drained = true
+				break
+			}
+			if sent, known := p.pending[id]; known {
+				delete(p.pending, id)
+				answered = answered || age(sent) <= voicePingTimeout
+			}
+		default:
+			drained = true
+		}
+	}
+	for id, sent := range p.pending {
+		if age(sent) >= voicePingTimeout {
+			delete(p.pending, id)
+			missed++
+		}
+	}
+	return answered, missed
+}
+
+// answers pings every voicePingInterval until one is answered, window ends or stop
+// is closed.
+func (p *voicePinger) answers(window time.Duration, stop <-chan struct{}) bool {
+	deadline := time.NewTimer(window)
+	defer deadline.Stop()
+	ticker := time.NewTicker(voicePingInterval)
+	defer ticker.Stop()
+	p.send()
+	for {
+		select {
+		case id, ok := <-p.replies:
+			if !ok {
+				return false
+			}
+			if _, known := p.pending[id]; known {
+				// The pings still out are not misses of the watch that takes this socket over.
+				clear(p.pending)
+				return true
+			}
+		case <-ticker.C:
+			p.send()
+		case <-deadline.C:
+			return false
+		case <-stop:
+			return false
+		}
+	}
+}
+
+const stunMagicCookie = 0x2112A442
+
+// stunBindingSuccess returns the transaction id of a STUN Binding Success Response.
+func stunBindingSuccess(packet []byte) ([12]byte, bool) {
+	var id [12]byte
+	if len(packet) < 20 || binary.BigEndian.Uint16(packet[0:]) != 0x0101 || binary.BigEndian.Uint32(packet[4:]) != stunMagicCookie {
+		return id, false
+	}
+	copy(id[:], packet[8:20])
+	return id, true
+}
+
+// voiceFlowConn counts packets out of one UDP flow. Writes must go through it, so
+// it is not writer-replaceable; reads pass straight to the upstream.
+type voiceFlowConn struct {
+	N.NetPacketConn
+	group *URLTestGroup
+	sent  atomic.Int64
+}
+
+func (c *voiceFlowConn) mark() {
+	if c.sent.Add(1) >= voiceFlowPackets {
+		c.group.voiceFlow()
+	}
+}
+
+func (c *voiceFlowConn) WritePacket(buffer *buf.Buffer, destination M.Socksaddr) error {
+	c.mark()
+	return c.NetPacketConn.WritePacket(buffer, destination)
+}
+
+func (c *voiceFlowConn) WriteTo(p []byte, addr net.Addr) (int, error) {
+	c.mark()
+	return c.NetPacketConn.WriteTo(p, addr)
+}
+
+func (c *voiceFlowConn) Upstream() any           { return c.NetPacketConn }
+func (c *voiceFlowConn) ReaderReplaceable() bool { return true }
+func (c *voiceFlowConn) WriterReplaceable() bool { return false }
diff --git a/protocol/group/urltest_voice_hikkari_test.go b/protocol/group/urltest_voice_hikkari_test.go
new file mode 100644
index 0000000..49d6771
--- /dev/null
+++ b/protocol/group/urltest_voice_hikkari_test.go
@@ -0,0 +1,245 @@
+package group
+
+import (
+	"context"
+	"encoding/binary"
+	"net"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// voiceNode is a node whose UDP leads to its own STUN server. silent drops every
+// request; refused fails every new socket at once, as a reset does; staleFirst
+// makes only the first socket silent, as a flow stuck on a connection that broke
+// while the node itself is fine.
+type voiceNode struct {
+	*penaltyDialNode
+	server     *net.UDPConn
+	silent     atomic.Bool
+	refused    atomic.Bool
+	staleFirst bool
+	listens    atomic.Int32
+}
+
+func newVoiceNode(t *testing.T, tag string) *voiceNode {
+	t.Helper()
+	server, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = server.Close() })
+	n := &voiceNode{penaltyDialNode: &penaltyDialNode{tag: tag, addr: "server"}, server: server}
+	go func() {
+		buffer := make([]byte, 1500)
+		for {
+			size, from, err := server.ReadFromUDP(buffer)
+			if err != nil {
+				return
+			}
+			if n.silent.Load() || size < 20 {
+				continue
+			}
+			response := make([]byte, 20)
+			binary.BigEndian.PutUint16(response[0:], 0x0101)
+			binary.BigEndian.PutUint32(response[4:], stunMagicCookie)
+			copy(response[8:], buffer[8:20])
+			_, _ = server.WriteToUDP(response, from)
+		}
+	}()
+	return n
+}
+
+func (n *voiceNode) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	if n.refused.Load() {
+		return nil, syscall.ECONNRESET
+	}
+	conn, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		return nil, err
+	}
+	stale := n.listens.Add(1) == 1 && n.staleFirst
+	return &voiceNodeConn{UDPConn: conn, node: n, stale: stale}, nil
+}
+
+// voiceNodeConn sends everything to the node's server, whatever the address.
+type voiceNodeConn struct {
+	*net.UDPConn
+	node  *voiceNode
+	stale bool
+}
+
+func (c *voiceNodeConn) WriteTo(p []byte, _ net.Addr) (int, error) {
+	if c.stale {
+		return len(p), nil
+	}
+	return c.UDPConn.WriteTo(p, c.node.server.LocalAddr())
+}
+
+func fastVoiceTimers(t *testing.T) {
+	t.Helper()
+	interval, timeout, verify, active := voicePingInterval, voicePingTimeout, voiceVerifyWindow, voiceActiveWindow
+	voicePingInterval, voicePingTimeout, voiceVerifyWindow = 20*time.Millisecond, 40*time.Millisecond, 100*time.Millisecond
+	voiceActiveWindow = 200 * time.Millisecond
+	t.Cleanup(func() {
+		voicePingInterval, voicePingTimeout, voiceVerifyWindow, voiceActiveWindow = interval, timeout, verify, active
+	})
+}
+
+func newVoiceGroup(t *testing.T) (g *URLTestGroup, held, spare, third *voiceNode) {
+	t.Helper()
+	fastVoiceTimers(t)
+	held, spare, third = newVoiceNode(t, "held"), newVoiceNode(t, "spare"), newVoiceNode(t, "third")
+	g = newPenaltyTestGroup(t, []*penaltyDialNode{held.penaltyDialNode, spare.penaltyDialNode, third.penaltyDialNode},
+		map[string]uint16{"held": 10, "spare": 50, "third": 30})
+	g.outbounds = []adapter.Outbound{held, spare, third}
+	g.outbound = &fakeManager{byTag: map[string]adapter.Outbound{"held": held, "spare": spare, "third": third}}
+	g.failover = true
+	g.selectedOutboundTCP = held
+	g.selectedOutboundUDP = held
+	ctx, cancel := context.WithCancel(context.Background())
+	g.ctx = ctx
+	// The watchdog must be gone before the timers are restored.
+	t.Cleanup(func() {
+		cancel()
+		waitSuspect(t, "the watchdog to stop", func() bool { return !g.voiceRunning.Load() })
+	})
+	return g, held, spare, third
+}
+
+// call keeps a flow active the way voiceFlowConn does, until the test ends.
+func call(t *testing.T, g *URLTestGroup) {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	go func() {
+		for ctx.Err() == nil {
+			g.voiceFlow()
+			time.Sleep(10 * time.Millisecond)
+		}
+	}()
+}
+
+func heldUDPTag(g *URLTestGroup) string {
+	g.access.Lock()
+	defer g.access.Unlock()
+	return g.selectedOutboundUDP.Tag()
+}
+
+func TestVoiceSilentNodeLosesUDPToFastestCandidate(t *testing.T) {
+	g, held, _, _ := newVoiceGroup(t)
+	call(t, g)
+	time.Sleep(100 * time.Millisecond)
+	start := time.Now()
+	held.silent.Store(true)
+	waitSuspect(t, "the UDP move", func() bool { return heldUDPTag(g) != "held" })
+	if tag := heldUDPTag(g); tag != "third" {
+		t.Fatalf("UDP must move to the fastest candidate, got %s", tag)
+	}
+	if elapsed := time.Since(start); elapsed > 20*voicePingInterval {
+		t.Fatalf("move took %s", elapsed)
+	}
+	// TCP has its own probe: the node still answers HTTP, so TCP stays.
+	waitSuspect(t, "the TCP probe", func() bool { return g.suspectEnd.Load() != 0 })
+	if g.heldTCP() != adapter.Outbound(held) {
+		t.Fatal("TCP must stay on a node that answers its own probe")
+	}
+}
+
+// A reset fails the suspect's fresh socket at once; that must not cut short the
+// wait for the candidates. Whichever answers first takes over.
+func TestVoiceResetNodeLosesUDP(t *testing.T) {
+	g, held, _, _ := newVoiceGroup(t)
+	call(t, g)
+	time.Sleep(100 * time.Millisecond)
+	held.refused.Store(true)
+	held.silent.Store(true)
+	waitSuspect(t, "the UDP move", func() bool { return heldUDPTag(g) != "held" })
+}
+
+func TestVoiceStaysWhenNoNodeAnswers(t *testing.T) {
+	g, held, spare, third := newVoiceGroup(t)
+	call(t, g)
+	time.Sleep(100 * time.Millisecond)
+	held.silent.Store(true)
+	spare.silent.Store(true)
+	third.silent.Store(true)
+	waitSuspect(t, "the verdict", func() bool { return g.voiceSilent.Load() })
+	time.Sleep(10 * voicePingInterval)
+	if tag := heldUDPTag(g); tag != "held" {
+		t.Fatalf("with every node silent the group must stay, moved to %s", tag)
+	}
+}
+
+func TestVoiceStaleSocketOnLiveNodeDoesNotMove(t *testing.T) {
+	g, held, _, _ := newVoiceGroup(t)
+	held.staleFirst = true
+	call(t, g)
+	waitSuspect(t, "a fresh socket", func() bool { return held.listens.Load() >= 2 })
+	time.Sleep(20 * voicePingInterval)
+	if tag := heldUDPTag(g); tag != "held" {
+		t.Fatalf("a node that answers on a fresh socket must stay, moved to %s", tag)
+	}
+	if g.voiceSilent.Load() {
+		t.Fatal("a node that answers is not an outage")
+	}
+}
+
+func TestVoiceNoSecondMoveInsideGap(t *testing.T) {
+	g, held, _, third := newVoiceGroup(t)
+	call(t, g)
+	time.Sleep(100 * time.Millisecond)
+	held.silent.Store(true)
+	waitSuspect(t, "the first move", func() bool { return heldUDPTag(g) == "third" })
+	third.silent.Store(true)
+	held.silent.Store(false)
+	time.Sleep(20 * voicePingInterval)
+	if tag := heldUDPTag(g); tag != "third" {
+		t.Fatalf("a second move inside voiceMoveGap must wait, moved to %s", tag)
+	}
+	g.voiceMoved.Store(0)
+	waitSuspect(t, "the move after the gap", func() bool { return heldUDPTag(g) != "third" })
+}
+
+// Nothing is sent without a call, and a DNS-sized exchange is not a call.
+func TestVoiceQuietWithoutAFlow(t *testing.T) {
+	g, held, _, _ := newVoiceGroup(t)
+	flow := &voiceFlowConn{NetPacketConn: &discardPacketConn{}, group: g}
+	for i := int64(1); i < voiceFlowPackets; i++ {
+		_ = flow.WritePacket(buf.As([]byte("query")), M.ParseSocksaddr("1.1.1.1:53"))
+	}
+	time.Sleep(10 * voicePingInterval)
+	if held.listens.Load() != 0 || g.voiceRunning.Load() {
+		t.Fatal("a short exchange must not start the watchdog")
+	}
+	_ = flow.WritePacket(buf.As([]byte("voice")), M.ParseSocksaddr("1.1.1.1:50000"))
+	waitSuspect(t, "the watchdog", func() bool { return held.listens.Load() > 0 })
+	waitSuspect(t, "the watchdog to stop", func() bool { return !g.voiceRunning.Load() })
+	listens := held.listens.Load()
+	time.Sleep(10 * voicePingInterval)
+	if held.listens.Load() != listens {
+		t.Fatal("an ended flow must leave no pings behind")
+	}
+}
+
+func TestVoiceOnlyInFailover(t *testing.T) {
+	g, _, _, _ := newVoiceGroup(t)
+	g.failover = false
+	conn := &discardPacketConn{}
+	if g.watchVoice(conn) != net.PacketConn(conn) {
+		t.Fatal("other modes keep the flow unwrapped")
+	}
+}
+
+type discardPacketConn struct{ N.NetPacketConn }
+
+func (c *discardPacketConn) WritePacket(buffer *buf.Buffer, _ M.Socksaddr) error {
+	buffer.Release()
+	return nil
+}
