diff --git a/protocol/group/urltest_capacity_hikkari.go b/protocol/group/urltest_capacity_hikkari.go
new file mode 100644
index 0000000..46ab230
--- /dev/null
+++ b/protocol/group/urltest_capacity_hikkari.go
@@ -0,0 +1,88 @@
+package group
+
+import (
+	"fmt"
+	"github.com/sagernet/sing-box/adapter"
+	"time"
+)
+
+// HikkariPreference is advisory ordering, not a health verdict. Its deadline
+// is enforced inside the core even when the GUI or hub disappears.
+type HikkariPreference struct {
+	Outbounds []string `json:"outbounds"`
+	ExpiresAt int64    `json:"expiresAt"`
+}
+
+func (s *URLTest) SetHikkariPreference(p HikkariPreference) error {
+	if !s.failover {
+		return fmt.Errorf("capacity advice requires failover mode")
+	}
+	if len(p.Outbounds) > 128 || (len(p.Outbounds) > 0 && (p.ExpiresAt <= time.Now().Unix() || p.ExpiresAt > time.Now().Add(90*time.Minute).Unix())) {
+		return fmt.Errorf("invalid capacity advice deadline")
+	}
+	s.members.RLock()
+	allowed := map[string]bool{}
+	for _, tag := range s.tags {
+		allowed[tag] = true
+	}
+	seen := map[string]bool{}
+	filtered := []string{}
+	for _, tag := range p.Outbounds {
+		if !allowed[tag] || seen[tag] {
+			continue
+		}
+		seen[tag] = true
+		filtered = append(filtered, tag)
+	}
+	s.members.RUnlock()
+	p.Outbounds = filtered
+	previous := s.preference.Swap(&p)
+	// Apply the initial policy to new connections. Later updates hold the
+	// working node, and do not flap established sessions on every hub refresh.
+	if previous == nil && len(p.Outbounds) > 0 {
+		if g := s.group.Load(); g != nil {
+			g.performSelectionUpdate(true)
+		}
+	}
+	return nil
+}
+
+func (g *URLTestGroup) hikkariRank(tag string) int {
+	if !g.failover || g.preference == nil {
+		return 129
+	}
+	p := g.preference.Load()
+	if p == nil || p.ExpiresAt <= time.Now().Unix() {
+		return 129
+	}
+	for rank, member := range p.Outbounds {
+		if member == tag {
+			return rank
+		}
+	}
+	return 129
+}
+
+func (g *URLTestGroup) hikkariPreferred(network string) adapter.Outbound {
+	var best adapter.Outbound
+	for _, candidate := range g.outbounds {
+		if !supportsNetwork(candidate, network) || g.hikkariRank(candidate.Tag()) == 129 {
+			continue
+		}
+		if g.history.LoadURLTestHistory(RealTag(g.outbound, candidate)) == nil || g.penaltyOf(RealTag(g.outbound, candidate)) > 0 {
+			continue
+		}
+		if best == nil || g.hikkariRank(candidate.Tag()) < g.hikkariRank(best.Tag()) {
+			best = candidate
+		}
+	}
+	return best
+}
+
+func (g *URLTestGroup) hikkariBetter(candidate, current adapter.Outbound, delay, currentDelay uint16) bool {
+	a, b := g.hikkariRank(candidate.Tag()), g.hikkariRank(current.Tag())
+	if a != b {
+		return a < b
+	}
+	return delay < currentDelay
+}
diff --git a/protocol/group/urltest_capacity_hikkari_test.go b/protocol/group/urltest_capacity_hikkari_test.go
new file mode 100644
index 0000000..97f17c9
--- /dev/null
+++ b/protocol/group/urltest_capacity_hikkari_test.go
@@ -0,0 +1,41 @@
+package group
+
+import (
+	"github.com/sagernet/sing-box/adapter"
+	N "github.com/sagernet/sing/common/network"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestHikkariCapacityAdviceRespectsHealthExpiryAndHeldNode(t *testing.T) {
+	lowPing := newFailoverNode("low-ping", 0)
+	highCapacity := newFailoverNode("high-capacity", 0)
+	g := newFailoverTestGroup(t, lowPing, highCapacity)
+	g.history.StoreURLTestHistory(lowPing.Tag(), &adapter.URLTestHistory{Time: time.Now(), Delay: 20})
+	g.history.StoreURLTestHistory(highCapacity.Tag(), &adapter.URLTestHistory{Time: time.Now(), Delay: 80})
+	policy := new(atomic.Pointer[HikkariPreference])
+	g.preference = policy
+	policy.Store(&HikkariPreference{Outbounds: []string{highCapacity.Tag()}, ExpiresAt: time.Now().Add(time.Minute).Unix()})
+	chosen, _ := g.failoverSelect(N.NetworkTCP, false)
+	if chosen != highCapacity {
+		t.Fatal("fresh capacity advice lost to RTT")
+	}
+	g.selectedOutboundTCP = lowPing
+	chosen, _ = g.failoverSelect(N.NetworkTCP, false)
+	if chosen != lowPing {
+		t.Fatal("advice moved a healthy held node")
+	}
+	g.selectedOutboundTCP = nil
+	g.history.DeleteURLTestHistory(highCapacity.Tag())
+	chosen, _ = g.failoverSelect(N.NetworkTCP, false)
+	if chosen != lowPing {
+		t.Fatal("advice overrode failed local health")
+	}
+	g.history.StoreURLTestHistory(highCapacity.Tag(), &adapter.URLTestHistory{Time: time.Now(), Delay: 80})
+	policy.Store(&HikkariPreference{Outbounds: []string{highCapacity.Tag()}, ExpiresAt: time.Now().Add(-time.Minute).Unix()})
+	chosen, _ = g.failoverSelect(N.NetworkTCP, false)
+	if chosen != lowPing {
+		t.Fatal("expired advice remained active")
+	}
+}
