@@ -0,0 +1,28 @@
+package clashapi
+
+import (
+	"github.com/go-chi/render"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/protocol/group"
+	"net/http"
+)
+
+// The loopback control API receives only ordering/deadline, never test data.
+func updateHikkariPreference(w http.ResponseWriter, r *http.Request) {
+	proxy := r.Context().Value(CtxKeyProxy).(adapter.Outbound)
+	auto, ok := proxy.(*group.URLTest)
+	if !ok {
+		http.Error(w, "not a URLTest group", http.StatusBadRequest)
+		return
+	}
+	var preference group.HikkariPreference
+	if err := render.DecodeJSON(http.MaxBytesReader(w, r.Body, 8192), &preference); err != nil {
+		http.Error(w, "invalid advice", http.StatusBadRequest)
+		return
+	}
+	if err := auto.SetHikkariPreference(preference); err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	render.NoContent(w, r)
+}
